# Copy this file to .env and/or .env.local, then replace placeholder values.
# Keep real secrets out of git.

# Database settings used by CTGov drug ontology DB loaders.
POSTGRES_DB=trial_curator
POSTGRES_USER=trial_curator
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://trial_curator:change_me@localhost:55432/trial_curator

# OpenAI key used by eligibility and drug LLM workflows.
OPENAI_API_KEY=sk-your-key-here

# CTGov eligibility pipeline settings loaded by scripts/eligibility/pipeline.sh.
ELIGIBILITY_DATA_DIR=data/ctgov/eligibility
ELIGIBILITY_MAX_WORKERS=1
ELIGIBILITY_CURATOR_LIMIT=
ELIGIBILITY_TRIAL_ID=
ELIGIBILITY_LOG_LEVEL=INFO
ELIGIBILITY_OUTPUT_FORMAT=tsv
ELIGIBILITY_EXPORT_DATE=
ELIGIBILITY_RUN_QA_DIFFS=0
ELIGIBILITY_QA_SNAPSHOT_DATE=
ELIGIBILITY_CANCER_TYPE_BASELINE_DIR=data/ctgov/eligibility/processed/cancer_type/baseline
ELIGIBILITY_GENE_ALTERATION_BASELINE_DIR=data/ctgov/eligibility/processed/gene_alteration/baseline
