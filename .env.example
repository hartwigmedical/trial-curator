# Copy this file to .env and/or .env.local, then replace placeholder values.
# Keep real secrets out of git.

# Database settings used by CTGov drug ontology DB loaders.
POSTGRES_DB=trial_curator
POSTGRES_USER=trial_curator
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://trial_curator:change_me@localhost:55432/trial_curator

# OpenAI key used by eligibility and drug LLM workflows.
OPENAI_API_KEY=sk-your-key-here

# Eligibility-path settings loaded by scripts/eligibility/pipeline.sh.
ELIGIBILITY_LOG_LEVEL=INFO
ELIGIBILITY_OUTPUT_FORMAT=tsv
ELIGIBILITY_EXPORT_DATE=
ELIGIBILITY_RUN_QA_DIFFS=0
ELIGIBILITY_SKIP_TESTS=0
CTGOV_INTERMEDIATE_DIR=data/eligibility_path/exports/intermediates/ctgov
ANZCTR_INTERMEDIATE_DIR=data/eligibility_path/exports/intermediates/anzctr
ANZCTR_RXNORM_RRF_DIR=data/drug_utility_path/drug_ontology/raw_inputs/RxNorm

# Optional ANZCTR LLM drug-review settings used by make eligibility-path-all-w-llm.
ELIGIBILITY_LLM_WORKERS=10
ELIGIBILITY_LLM_MAX_RETRIES=10
ELIGIBILITY_LLM_RETRY_INITIAL_DELAY=2
ELIGIBILITY_LLM_RETRY_MAX_DELAY=60
ELIGIBILITY_LLM_LIMIT=
ELIGIBILITY_LLM_MODEL=
